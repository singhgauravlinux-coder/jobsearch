# Copy this file to setup.env and fill in your values, then run ./setup.sh
# setup.env is gitignored — never commit real secrets.

# --- image delivery ---
# registry = build, push to REGISTRY, cluster pulls from there (any cluster, any node count)
# local    = build locally and load straight into k3s's containerd — no registry, no push.
#            Only works when setup.sh runs on (or can SSH to) the k3s node itself, and only
#            makes sense for a single-node cluster (image has to be imported on every node
#            that might schedule the pod).
DEPLOY_MODE=registry

# --- container registry (used when DEPLOY_MODE=registry) ---
# Where images get pushed and where the cluster pulls them from.
# The CI/CD workflow (.github/workflows/ci.yml) pushes to GHCR on every
# push to main, so this should point at the same place: ghcr.io/<your
# GitHub username or org>. The image names themselves (ai-job-search-backend,
# ai-job-search-frontend) are fixed by setup.sh - only the prefix is yours.
REGISTRY=ghcr.io/yourusername
IMAGE_TAG=latest

# --- local k3s import (used when DEPLOY_MODE=local) ---
# Leave blank if setup.sh runs directly on the k3s node (most common for a
# single homelab box). Set to user@host if the node is elsewhere and you can
# SSH to it with a key (no password prompt) and passwordless sudo.
K3S_SSH_HOST=
# Command used to reach containerd. k3s bundles its own ctr; k0s/rke2 differ —
# adjust if you're not on plain k3s (e.g. rke2 uses "rke2 ctr"). Must stay quoted.
K3S_CTR_CMD="k3s ctr"

# --- cluster ---
NAMESPACE=ai-job-search
# Hostname the Ingress listens on. Use a real domain, or a nip.io address that
# resolves to your node's IP for local testing, e.g. jobsearch.192.168.1.50.nip.io
INGRESS_HOST=jobsearch.local

# --- your ai-job-search fork ---
# Three options:
#   1) A real GitHub URL (public repo, or private + GIT_TOKEN below)
#   2) A local bare repo on this node - no GitHub/registry needed at all.
#      Set up once with:
#        mkdir -p /home/ubuntu/local-repos
#        git init --bare /home/ubuntu/local-repos/ai-job-search.git
#        cd <your source checkout, including .agents/skills/>
#        git remote add local /home/ubuntu/local-repos/ai-job-search.git
#        git push local main
#        sudo git config --global --add safe.directory /home/ubuntu/local-repos/ai-job-search.git
#        sudo git -C /home/ubuntu/local-repos/ai-job-search.git symbolic-ref HEAD refs/heads/main
#      Then set: GIT_REPO_URL=file:///local-repos/ai-job-search.git
#      (container-side path - the hostPath mount in 04-backend.yaml exposes
#      /home/ubuntu/local-repos as /local-repos inside the pod)
#   3) Leave blank to skip repo sync entirely (Scrape tab and repo-based
#      profile unavailable; paste your profile in the UI instead).
GIT_REPO_URL=https://github.com/singhgauravlinux-coder/jobsearch.git
# Only needed for a private GitHub fork: a fine-grained PAT with read-only
# access to this one repo. Leave blank for a public fork or local file:// repo.
GIT_TOKEN=

# --- LLM (Gemini, free tier) ---
# Get a free key (no card) at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-free-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- behavior flags ---
# true  = build images (and push/import, depending on DEPLOY_MODE) before deploying
# false = skip build and just (re)apply manifests with images already in place
BUILD_IMAGES=true
